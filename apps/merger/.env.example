# Same physical database as yoroi-control (packages/postgres's shared
# schema), but yoroi-merger should connect with its own minimally-privileged
# DB role in production (design.md §17.5) — never the same credential
# yoroi-control uses.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/yoroi_control"

# Merger App credentials — merge-only minimal GitHub App permissions,
# separate App/key from yoroi-control's Observer App (design.md §13.10).
MERGER_GITHUB_APP_ID=""
MERGER_GITHUB_APP_PRIVATE_KEY=""

# MVP shared-secret stand-in for real Deno Deploy OIDC + envelope signing
# (see src/oidc.ts's comment) — must match yoroi-control's own
# YOROI_MERGER_SHARED_TOKEN exactly. Also doubles as the HMAC key that
# verifies the Decision Envelope's signature.
YOROI_MERGER_SHARED_TOKEN="dev-only-shared-secret"

# Set to "1" to allow booting when Deno Deploy's DENO_TIMELINE env var isn't
# exactly "production" — local dev/testing only (see main.ts's comment;
# design.md §17.3). Never set this in the app's Production context secrets.
YOROI_MERGER_DEV="1"

# Port for `deno task dev` / `deno task start`. Deno Deploy sets its own PORT.
PORT="8788"
