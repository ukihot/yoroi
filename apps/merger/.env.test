# Dummy values — handler.ts/oidc.ts unit tests use fake MergerContext/
# OidcVerifier objects and never read these; main.ts (which does read them)
# is never imported by a test file. Present only because --env-file errors
# if the file is missing at all.
DATABASE_URL="postgres://test:test@localhost:5432/yoroi_test_unused"
MERGER_GITHUB_APP_ID="test-placeholder"
MERGER_GITHUB_APP_PRIVATE_KEY="test-placeholder"
YOROI_MERGER_SHARED_TOKEN="test-placeholder"
