# Dummy values so importing db/client.ts (which reads DATABASE_URL at module
# load time) doesn't throw during `deno task test`. The `postgres` driver
# connects lazily, and app.test.ts only exercises routes that never reach a
# DB-touching handler (see that file's top comment) — no connection to this
# URL is ever actually attempted.
DATABASE_URL="postgres://test:test@localhost:5432/yoroi_control_test_unused"
YOROI_CONTROL_API_TOKEN="test-placeholder"
YOROI_DEFAULT_ROLE="operator"
