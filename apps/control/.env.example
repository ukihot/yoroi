# PostgreSQL connection string. In production this is the connection string
# for Deno Deploy's built-in Postgres database (provisioned per-app in the
# Deno Deploy dashboard) — set as a Production-context secret, never committed.
# Locally, point this at any Postgres (e.g. `docker run -p 5432:5432 -e
# POSTGRES_PASSWORD=postgres postgres:16`).
DATABASE_URL="postgres://postgres:postgres@localhost:5432/yoroi_control"

# Shared secret yoroi-console authenticates with (Authorization: Bearer <token>).
# MVP stand-in for design.md §17.4/§24.4's org SSO/OIDC federation between the
# two apps — see src/lib/auth.ts.
YOROI_CONTROL_API_TOKEN="dev-only-shared-secret"

# Port for `deno task dev` / `deno task start`. Deno Deploy sets its own PORT.
PORT="8787"

# Fallback role for GET /api/role when no real ownership-graph data exists yet
# (see src/routes/role.ts).
YOROI_DEFAULT_ROLE="operator"

# --- GitHub App (design.md §13.1/§13.3) --------------------------------------
# Observer App credentials — read/evaluate/comment permissions only, never
# merge. See src/lib/github-client.ts. Required by anything that reaches
# GET /github/webhook or the outbox worker; not required to boot the app.
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""

# Verifies GitHub's webhook HMAC signature (src/routes/webhook.ts,
# packages/github/src/webhook-verify.ts). SEC-007.
GITHUB_WEBHOOK_SECRET=""

# AES-256-GCM key (packages/postgres/src/encryption.ts) for the short-TTL
# encrypted raw payload of pull_request/pull_request_review/issue_comment
# events (design.md §7.1 shouldPersistRaw, FR-002). Leave unset to skip raw
# payload retention entirely (minimal-facts-only, still fully functional).
WEBHOOK_PAYLOAD_ENCRYPTION_KEY=""

# --- yoroi-merger call (design.md §12.2/§17.4) -------------------------------
# Base URL of the separate yoroi-merger app (see ../merger's own README).
YOROI_MERGER_URL="http://localhost:8788"

# MVP shared-secret stand-in for real Deno Deploy OIDC + envelope signing
# (see src/lib/identity-issuer.ts's comment) — must match yoroi-merger's own
# YOROI_MERGER_SHARED_TOKEN exactly.
YOROI_MERGER_SHARED_TOKEN="dev-only-shared-secret"

# --- Cron cost tuning (src/config.ts) ----------------------------------------
# All optional — every one has a sensible default in src/config.ts. Override
# from the Deno Deploy dashboard (no redeploy needed) if the free-tier
# CPU-time budget is tight; see the root README's troubleshooting entry.
# YOROI_CRON_OUTBOX_SWEEP_AND_TTL_EXPIRY="* * * * *"
# YOROI_CRON_GITHUB_RECONCILE="*/5 * * * *"
# YOROI_CRON_APPROVAL_MEMBERSHIP_SCAN="0 * * * *"
# YOROI_CRON_EVIDENCE_COMPLETENESS="0 3 * * *"
# YOROI_CRON_DASHBOARD_ROLLUP="*/15 * * * *"
# YOROI_CRON_OUTBOX_SWEEP_BUDGET_MS="20000"
