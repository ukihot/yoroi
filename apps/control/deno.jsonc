{
	// yoroi-control (design.md §2.2, §17). Deno Deploy app; kept independent of
	// the root SvelteKit app's npm toolchain (see .prettierignore / eslint.config.js
	// at the repo root, which explicitly ignore this directory).
	"tasks": {
		"dev": "deno run --watch --env-file=.env -A main.ts",
		"start": "deno run -A main.ts",
		"check": "deno check main.ts",
		"test": "deno test -A --env-file=.env.test",
		"migrate": "deno run --env-file=.env -A src/db/migrate.ts",
		"seed": "deno run --env-file=.env -A src/db/seed.ts",
		"fmt": "deno fmt",
		"lint": "deno lint"
	},
	"imports": {
		"@yoroi/domain": "../../packages/domain/mod.ts",
		"@yoroi/github": "../../packages/github/mod.ts",
		"@yoroi/postgres": "../../packages/postgres/mod.ts",
		"@yoroi/policy": "../../packages/policy/mod.ts",
		"@yoroi/evidence": "../../packages/evidence/mod.ts",
		"@yoroi/notifications": "../../packages/notifications/mod.ts",
		"@yoroi/observability": "../../packages/observability/mod.ts",
		"drizzle-orm": "npm:drizzle-orm@0.45.2",
		"drizzle-orm/": "npm:/drizzle-orm@0.45.2/",
		"zod": "npm:zod@3",
		"octokit": "npm:octokit@3",
		"@std/assert": "jsr:@std/assert@^1",
		"@std/testing/mock": "jsr:@std/testing@^1/mock"
	},
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 100
	},
	"lint": {
		"rules": { "tags": ["recommended"] }
	}
}
