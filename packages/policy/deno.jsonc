{
	"tasks": {
		"check": "deno check mod.ts",
		"test": "deno test -A",
		"fmt": "deno fmt",
		"lint": "deno lint"
	},
	"imports": {
		"@yoroi/domain": "../domain/mod.ts",
		"zod": "npm:zod@3",
		"fast-check": "npm:fast-check@3",
		"@std/assert": "jsr:@std/assert@^1"
	},
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true
	},
	"fmt": { "useTabs": true, "lineWidth": 100 },
	"lint": { "rules": { "tags": ["recommended"] } }
}
