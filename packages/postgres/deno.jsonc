{
	"tasks": {
		"check": "deno check mod.ts",
		"test": "deno test -A",
		"fmt": "deno fmt",
		"lint": "deno lint",
		"migrate": "deno run -A src/migrations/run.ts"
	},
	"imports": {
		"@yoroi/domain": "../domain/mod.ts",
		"@yoroi/evidence": "../evidence/mod.ts",
		"drizzle-orm": "npm:drizzle-orm@0.45.2",
		"drizzle-orm/": "npm:/drizzle-orm@0.45.2/",
		"postgres": "npm:postgres@3.4.9",
		"@std/assert": "jsr:@std/assert@^1"
	},
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true
	},
	"fmt": { "useTabs": true, "lineWidth": 100 },
	"lint": { "rules": { "tags": ["recommended"] } }
}
