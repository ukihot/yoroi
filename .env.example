# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
# GitHub OAuth
# https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# yoroi-control (apps/control — see apps/control/README.md). Leave unset to
# keep using the static mock data in src/lib/server/yoroi/mock-control-api.ts.
YOROI_CONTROL_URL=""
YOROI_CONTROL_API_TOKEN=""

# Fallback role when yoroi-control isn't reachable / configured (design.md 24.4節).
YOROI_DEV_ROLE=""
